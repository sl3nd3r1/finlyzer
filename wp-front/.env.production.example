# Finlyzer — Production Environment Configuration Template
# Copy to .env.production when compiling a production release archive.

FINLYZER_ENV=production

# Cloudflare Worker production endpoints (Must use HTTPS, No loopback/private IPs)
FINLYZER_WORKER_ENDPOINT=https://finlyzer-worker-prod.workers.dev/insight
FINLYZER_WORKER_ANALYZE_ENDPOINT=https://finlyzer-worker-prod.workers.dev/api/v1/analyze

# Shared HMAC Secret (Recommended: Inject via wp-config.php or environment secret)
FINLYZER_WORKER_HMAC_SECRET=

# Production Security & Hardening Flags
FINLYZER_ENABLE_DEV_TOOLS=false
FINLYZER_DEBUG_LOGGING=false
FINLYZER_ALLOW_HTTP=false
FINLYZER_FORCE_API_CALCULATION=true
FINLYZER_STRICT_SSL=true
FINLYZER_API_TIMEOUT=8
