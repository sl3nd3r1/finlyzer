# Finlyzer — Development Environment Configuration Template
# Copy to .env.development and customize for your local development setup.

FINLYZER_ENV=development

# Cloudflare Worker insight and calculation endpoints
FINLYZER_WORKER_ENDPOINT=http://127.0.0.1:8787/insight
FINLYZER_WORKER_ANALYZE_ENDPOINT=http://127.0.0.1:8787/api/v1/analyze

# Shared HMAC Secret (Matches WORKER_HMAC_SECRET in Worker dev environment)
FINLYZER_WORKER_HMAC_SECRET=dev-ephemeral-secret-32-byte-hex-token

# Developer Experience Flags
FINLYZER_ENABLE_DEV_TOOLS=true
FINLYZER_DEBUG_LOGGING=true
FINLYZER_ALLOW_HTTP=true
FINLYZER_FORCE_API_CALCULATION=true
FINLYZER_STRICT_SSL=false
FINLYZER_API_TIMEOUT=15
